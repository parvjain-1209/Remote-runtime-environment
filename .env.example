# Environment Variables Template
# Copy this file to .env for local development configuration

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onlinejudge

# Redis Connection URL
REDIS_URL=redis://localhost:6379/0

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Stream & Consumer Settings
REDIS_STREAM_NAME=submission_jobs
REDIS_CONSUMER_GROUP=judge_workers
WORKER_CONSUMER_NAME=worker-1

# Constraints & Security
SOURCE_CODE_MAX_BYTES=65536
MAX_REQUEST_BODY_BYTES=102400
STALE_JOB_TIMEOUT_SECONDS=30.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker-out-of-Docker Path Settings
WORKER_WORKSPACE_DIR=/runtime-workspaces
# HOST_WORKSPACE_DIR automatically defaults to ${PWD}/runtime-workspaces in docker-compose.yml
HOST_WORKSPACE_DIR=
