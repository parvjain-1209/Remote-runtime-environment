# GDG Remote Runtime - Production Environment Configuration

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ProductionPassword_ChangeMe2026!
POSTGRES_DB=gdg_judge_prod
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_NAME=submission_jobs
REDIS_CONSUMER_GROUP=worker_group

# Security & JWT Token Auth
SECRET_KEY=PROD_JWT_SECRET_KEY_MUST_BE_AT_LEAST_32_BYTES_LONG_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Worker & Docker Sandbox Policy
WORKER_CONSUMER_NAME=worker-prod-1
HOST_WORKSPACE_DIR=/runtime-workspaces
STALE_JOB_TIMEOUT_SECONDS=60.0

# CORS Production Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,https://yourdomain.com
